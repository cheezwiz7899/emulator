--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -239,18 +239,28 @@
 if(WIN32)
   list(APPEND SDL2COMPAT_SRCS
-    "src/sdl2_mslibc.c"
     "src/version.rc"
   )
 endif()
+# When SDL_LIBC is ON the caller links the MSVC CRT (/MD or /MDd), so SDL's
+# own C-runtime reimplementations and MASM stdlib stubs are unnecessary.
+# Skipping them avoids:
+#   - _fltused undefined symbol: lld-link discards the selectany definition
+#     in sdl2_mslibc.c under LTO when the MASM stub is also absent.
+#   - A1013 fatal error: passing clang-cl flags (-Wundef, /W3, etc.) to
+#     ml64.exe, which does not understand them.
+option(SDL_LIBC "Use the system C library (skip MASM/C stdlib reimpl)" ON)
+if(WIN32 AND NOT SDL_LIBC)
+  list(APPEND SDL2COMPAT_SRCS "src/sdl2_mslibc.c")
+endif()
 if(MSVC)
-  if(SDL_CPU_X64)
+  if(SDL_CPU_X64 AND NOT SDL_LIBC)
     list(APPEND SDL2COMPAT_SRCS
       "src/sdl2_mslibc_x64.masm"
     )
     enable_language(ASM_MASM)
     set_property(SOURCE "src/sdl2_mslibc_x64.masm" PROPERTY LANGUAGE "ASM_MASM")
-  elseif(SDL_CPU_ARM64)
+  elseif(SDL_CPU_ARM64 AND NOT SDL_LIBC)
     list(APPEND SDL2COMPAT_SRCS
       "src/sdl2_mslibc_arm64.masm"
     )
     enable_language(ASM_MARMASM)
     set_property(SOURCE "src/sdl2_mslibc_arm64.masm" PROPERTY LANGUAGE "ASM_MARMASM")
   elseif(SDL_CPU_ARM32)
@@ -383,10 +393,12 @@
 if(MSVC)
   # Don't try to link with the default set of libraries.
-  target_compile_options(SDL2 PRIVATE "$<$<COMPILE_LANGUAGE:C>:/GS->")
+  if(NOT SDL_LIBC)
+    target_compile_options(SDL2 PRIVATE "$<$<COMPILE_LANGUAGE:C>:/GS->")
+  endif()
   if(SDL_CPU_X86)  # don't emit SSE2 in x86 builds
     target_compile_options(SDL2 PRIVATE "$<$<COMPILE_LANGUAGE:C>:/arch:SSE>")
   endif()
-  if(NOT MSVC_CLANG AND NOT SDL_CPU_ARM32)
+  if(NOT MSVC_CLANG AND NOT SDL_CPU_ARM32 AND NOT SDL_LIBC)
     set_property(TARGET SDL2 APPEND_STRING PROPERTY LINK_FLAGS " /NODEFAULTLIB")
   endif()
